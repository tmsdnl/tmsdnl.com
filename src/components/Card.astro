---
import type { CollectionEntry } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
  showTopBorder?: boolean;
} & CollectionEntry<"blog">;

const {
  variant: Heading = "h2",
  showTopBorder = true,
  id,
  data,
  filePath,
} = Astro.props;

const { title, description, ...props } = data;
const href = getPath(id, filePath);
---

<li
  class:list={[
    "border-b border-border py-6 last:border-b-0",
    { "first:border-t": showTopBorder },
  ]}
>
  <a
    href={href}
    class:list={[
      "inline-block text-lg font-medium text-accent",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
    >
      {title}
    </Heading>
  </a>
  <Datetime class="mt-1" {...props} />
  <p class="mt-1">{description}</p>
</li>
