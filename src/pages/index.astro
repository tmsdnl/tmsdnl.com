---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import Card from "@/components/Card.astro";
import NoteListItem from "@/components/NoteListItem.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import getSortedNotes from "@/utils/getSortedNotes";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { SOCIALS } from "@/constants";

const posts = await getCollection("blog");
const notes = await getCollection("notes");

const sortedPosts = getSortedPosts(posts);
const sortedNotes = getSortedNotes(notes);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const recentItems = [
  ...recentPosts.map(post => ({
    kind: "post" as const,
    item: post,
    datetime: post.data.modDatetime ?? post.data.pubDatetime,
  })),
  ...sortedNotes.map(note => ({
    kind: "note" as const,
    item: note,
    datetime: note.data.modDatetime ?? note.data.pubDatetime,
  })),
]
  .sort((a, b) => b.datetime.getTime() - a.datetime.getTime())
  .slice(0, 5);
---

<Layout>
  <Header />
  <main id="main-content" data-layout="index" class="app-layout">
    <section id="hero" class:list={["pt-8 pb-6", "border-b border-border"]}>
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Field notes on tools, agents and systems
      </h1>

      <p>
        AI experiments, automation, dev tooling, homelab infrastructure, and
        small hardware projects. Mostly experiments, sometimes finished tools.
      </p>
      {
        // only display if at least one social link is enabled
        SOCIALS.length > 0 && (
          <div class="mt-4 flex items-center gap-1">
            <Socials />
            <LinkButton
              href="/rss.xml"
              class="p-2 sm:p-1"
              title="RSS Feed"
              aria-label="rss feed"
            >
              <IconRss class="inline-block size-6 scale-125 stroke-accent stroke-3 opacity-90 group-hover:fill-transparent sm:scale-110 rtl:-rotate-90" />
              <span class="sr-only">RSS Feed</span>
            </LinkButton>
          </div>
        )
      }
    </section>

    {
      featuredPosts.length > 0 && (
        <section
          id="featured"
          class:list={[
            "pt-12 pb-6",
            { "border-b border-border": recentItems.length > 0 },
          ]}
        >
          <h2 class="text-2xl font-semibold tracking-wide">Featured</h2>
          <ul>
            {featuredPosts.map(data => (
              <Card variant="h3" showTopBorder={false} {...data} />
            ))}
          </ul>
        </section>
      )
    }

    {
      recentItems.length > 0 && (
        <section id="recent" class="pt-6 pb-6">
          <h2 class="mb-1 text-lg font-semibold tracking-wide">Recent</h2>
          <ul>
            {recentItems.map(data =>
              data.kind === "post" ? (
                <Card variant="h3" showTopBorder={false} {...data.item} />
              ) : (
                <NoteListItem
                  note={data.item}
                  showTopBorder={false}
                  showSourceLink={false}
                  preview
                />
              )
            )}
          </ul>
        </section>
      )
    }

    <div class="my-8 flex justify-center gap-3 text-center">
      <LinkButton href="/posts/">
        All Posts
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
      <LinkButton href="/notes/">
        All Notes
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset?.layout;
    if (indexLayout) {
      sessionStorage.setItem("backUrl", "/");
    }
  });
</script>
